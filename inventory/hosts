#version 2.0
#Stand 17.09.2026

# ---------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------

# Der bisherige Ansible-Controller gehoert hier mit rein (unter seinem echten
# Hostnamen) - unter Semaphore patcht er sich nicht mehr selbst via localhost.
[linux_server]
glpi-01
v-ts-obsrv-01

[linux_glpi]
glpi-01

[linux_server:vars]
# SSH-Key kommt aus dem Semaphore Key Store und wird zur Laufzeit injiziert,
# deshalb steht hier kein ansible_ssh_private_key_file mehr.
ansible_user=ladmin

# ---------------------------------------------------------------------------
# Windows
#
# Alle Windows-Gruppen haengen unter [windows]. Die WinRM-Verbindungsparameter
# stehen deshalb genau einmal in [windows:vars] statt frueher 12x pro Gruppe.
# Neue Windows-Gruppe anlegen = Gruppe definieren + unter [windows:children]
# eintragen, sonst fehlt ihr die Verbindungskonfiguration.
# ---------------------------------------------------------------------------

[windows:children]
test
windows_manage
windows_test
windows_entwicklung
windows_upla
windows_ad
windows_pm
windows_produktion
windows_produktionkrit
windows_fileserver
windows_notdomain
windows_debug

[windows:vars]
ansible_connection=winrm
ansible_winrm_transport=ntlm
ansible_port=5985
ansible_winrm_server_cert_validation=ignore
ansible_winrm_operation_timeout_sec=1000
ansible_winrm_read_timeout_sec=1200

